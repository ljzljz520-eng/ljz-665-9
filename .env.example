# ====== 服务端口 ======
PORT=3000

# ====== 数据库驱动 ======
# json = 本地文件数据库 data/db.json（免安装，演示/测试用）
# mssql = Microsoft SQL Server（生产使用）
DB_DRIVER=json

# ====== SQL Server 连接配置（DB_DRIVER=mssql 时生效）======
DB_SERVER=localhost
DB_NAME=PumpStationArchive
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
# 默认实例 + 静态端口（常见 1433）：
DB_PORT=1433
# 命名实例与端口二选一，配置实例名后端口被忽略：
#DB_INSTANCE=SQLEXPRESS
# 本地 SQL Server 一般 false；Azure SQL 必须 true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_CONNECT_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000
DB_POOL_MAX=10

# ====== 文件与上传 ======
MAX_UPLOAD_MB=50
#UPLOAD_DIR=/data/pump/uploads
#DATA_FILE=/data/pump/db.json
